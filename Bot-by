    if q.data == "scan":
        df = get_xauusd_candles()
        a  = analyze(df)
        await q.message.reply_text(format_signal(a), parse_mode="Markdown")
    elif q.data == "price":
        price = get_xauusd_price()
        await q.message.reply_text(f"💲 *XAUUSD* : `{price:.2f}`", parse_mode="Markdown")
    elif q.data == "taken":
        await q.message.reply_text("✅ *Trade pris ! Bonne chance !* 🎯", parse_mode="Markdown")
    elif q.data == "ignored":
        await q.message.reply_text("❌ Ignoré. Le bot continue de surveiller.", parse_mode="Markdown")
