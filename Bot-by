def get_xauusd_candles(n=100):
    try:
        url = "https://query1.finance.yahoo.com/v8/finance/chart/GC=F?interval=15m&range=5d"
        r = requests.get(url, timeout=15, headers={"User-Agent": "Mozilla/5.0"})
        data = r.json()
        result = data["chart"]["result"][0]
        timestamps = result["timestamp"]
        ohlcv = result["indicators"]["quote"][0]
        df = pd.DataFrame({
            "time":   pd.to_datetime(timestamps, unit="s"),
            "open":   ohlcv["open"],
            "high":   ohlcv["high"],
            "low":    ohlcv["low"],
            "close":  ohlcv["close"],
            "volume": ohlcv["volume"],
        }).dropna()
        return df.tail(n).reset_index(drop=True)
    except Exception as e:
        log.error(f"Erreur candles: {e}")
        return pd.DataFrame()

def compute_atr(df, period=14):
    hl = df["high"] - df["low"]
    hc = np.abs(df["high"] - df["close"].shift())
    lc = np.abs(df["low"]  - df["close"].shift())
    tr = pd.concat([hl, hc, lc], axis=1).max(axis=1)
    return tr.rolling(period).mean()

def ema(series, period):
    return series.ewm(span=period, adjust=False).mean()

def compute_rsi(series, period=14):
    delta = series.diff()
    gain  = delta.clip(lower=0).rolling(period).mean()
    loss  = (-delta.clip(upper=0)).rolling(period).mean()
    rs    = gain / loss.replace(0, np.nan)
    return 100 - (100 / (1 + rs))

def detect_regime(df):
    df = df.copy()
    df["atr"] = compute_atr(df)
    df["e20"] = ema(df["close"], 20)
    df["e50"] = ema(df["close"], 50)
    slope    = df["e20"].iloc[-1] - df["e50"].iloc[-1]
    atr_now  = df["atr"].iloc[-1]
    atr_mean = df["atr"].mean()
    if slope > 0 and atr_now > atr_mean: return "TREND_UP"
    if slope < 0 and atr_now > atr_mean: return "TREND_DOWN"
    return "RANGE"

def detect_bos(df):
    n = len(df)
    if n < 10: return {"bos": False}
    res = df["high"].iloc[-10:-1].max()
    sup = df["low"].iloc[-10:-1].min()
    last_close = df["close"].iloc[-1]
    if last_close > res: return {"bos": True, "type": "bullish", "level": res}
    if last_close < sup: return {"bos": True, "type": "bearish", "level": sup}
    return {"bos": False}

def detect_sweep(df):
    prev_high  = df["high"].iloc[-2]
    prev_low   = df["low"].iloc[-2]
    last_close = df["close"].iloc[-1]
    last_high  = df["high"].iloc[-1]
    last_low   = df["low"].iloc[-1]
    if last_low < prev_low and last_close > prev_low:    return "SWEEP_BUY"
    if last_high > prev_high and last_close < prev_high: return "SWEEP_SELL"
    return "NO_SWEEP"

def momentum_ok(df):
    c = df.iloc[-1]
    body  = abs(c["close"] - c["open"])
    range_= c["high"] - c["low"]
    return range_ > 0 and (body / range_) > 0.60

def analyze(df):
    if df.empty or len(df) < 55:
        return {"signal": "NO_DATA"}
    closes  = df["close"]
    regime  = detect_regime(df)
    bos     = detect_bos(df)
    sweep   = detect_sweep(df)
    mom     = momentum_ok(df)
    rsi_val = compute_rsi(closes).iloc[-1]
    atr_val = compute_atr(df).iloc[-1]
    e20     = ema(closes, 20).iloc[-1]
    e50     = ema(closes, 50).iloc[-1]
    price   = closes.iloc[-1]
    score   = 0
    signal  = "WAIT"
    if regime == "TREND_UP":
        if bos.get("type") == "bullish": score += 2
        if sweep == "SWEEP_BUY":         score += 2
        if mom:                           score += 1
        if rsi_val < 60:                  score += 1
        if score >= 3: signal = "BUY"
    elif regime == "TREND_DOWN":
        if bos.get("type") == "bearish": score += 2
        if sweep == "SWEEP_SELL":         score += 2
        if mom:                           score += 1
        if rsi_val > 40:                  score += 1
        if score >= 3: signal = "SELL"
    sl = round(price - atr_val * 1.5, 2) if signal == "BUY"  else round(price + atr_val * 1.5, 2) if signal == "SELL" else None
    tp = round(price + atr_val * 3.0, 2) if signal == "BUY"  else round(price - atr_val * 3.0, 2) if signal == "SELL" else None
    return {
        "signal": signal, "regime": regime, "bos": bos,
        "sweep": sweep, "mom": mom, "rsi": round(rsi_val, 1),
        "atr": round(atr_val, 2), "price": round(price, 2),
        "e20": round(e20, 2), "e50": round(e50, 2),
        "sl": sl, "tp": tp, "score": min(score, 5),
        "time": datetime.now().strftime("%d/%m %H:%M"),
    }

def format_signal(a):
    if a.get("signal") == "NO_DATA":
        return "⚠️ Données indisponibles"
    sig   = a["signal"]
    emoji = "🟢 ACHAT" if sig == "BUY" else "🔴 VENTE" if sig == "SELL" else "⏳ EN ATTENTE"
    bars  = "▰" * a["score"] + "▱" * (5 - a["score"])
    rr    = round(abs(a["tp"] - a["price"]) / abs(a["price"] - a["sl"]), 1) if a["sl"] and a["tp"] and a["price"] != a["sl"] else "—"
    msg = (
        f"*{'━'*22}*\n"
        f"⚡ *SIGNAL XAUUSD — {emoji}*\n"
        f"*{'━'*22}*\n\n"
        f"💲 Prix : `{a['price']:.2f}`\n"
        f"📈 Régime : `{a['regime']}`\n"
        f"💪 Force : `{bars}` {a['score']}/5\n\n"
        f"*📋 ANALYSE SMC*\n"
        f"├ BOS    : {'✅' if a['bos'].get('bos') else '❌'} `{a['bos'].get('type','—')}`\n"
        f"├ Sweep  : {'✅' if a['sweep'] != 'NO_SWEEP' else '❌'} `{a['sweep']}`\n"
        f"├ Momentum: {'✅' if a['mom'] else '❌'}\n"
        f"├ RSI    : `{a['rsi']}`\n"
        f"├ EMA20  : `{a['e20']}`\n"
        f"└ EMA50  : `{a['e50']}`\n"
    )
    if sig in ("BUY", "SELL"):
        msg += (
            f"\n*🎯 NIVEAUX*\n"
            f"├ 🔵 Entrée : `{a['price']:.2f}`\n"
            f"├ 🔴 SL     : `{a['sl']:.2f}`\n"
            f"├ 🟢 TP     : `{a['tp']:.2f}`\n"
            f"└ ⚖️  R/R    : `1:{rr}`\n\n"
            f"⚠️ _Exécutez sur MT5 manuellement_\n"
        )
    msg += f"\n🕐 `{a['time']}`"
    return msg

def send_telegram(text, keyboard=None):
    url = f"https://api.telegram.org/bot{TG_TOKEN}/sendMessage"
    payload = {"chat_id": TG_CHAT_ID, "text": text, "parse_mode": "Markdown"}
    if keyboard:
        payload["reply_markup"] = {"inline_keyboard": keyboard}
    try:
        requests.post(url, json=payload, timeout=10)
    except Exception as e:
        log.error(f"Telegram error: {e}")

